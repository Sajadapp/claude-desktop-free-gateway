# Copy to .env and set values. NEVER commit a real key.
# This must match the "API key" field in Claude Desktop Gateway settings.
GATEWAY_API_KEY=local-dev-key-12345
# opencode serve endpoint (gateway spawns it if not reachable).
OPENCODE_SERVE_URL=http://127.0.0.1:4097
OPENCODE_SERVE_USERNAME=opencode
OPENCODE_SERVE_PASSWORD=change-me-in-your-.env
# Path to opencode binary (must be on PATH, or set absolute path here).
# Windows npm example: C:\Users\YOU\AppData\Roaming\npm\node_modules\opencode-ai\bin\opencode.exe
OPENCODE_EXE=opencode
# Gateway listen port.
PORT=3457
# Combo file mapping Claude aliases -> ordered free-model fallback chains.
COMBO_PATH=combo.json
# Leave "false": disabling all tools makes several free models return empty
# replies. Sessions run in the detected project folder (sandbox fallback) -
# keep no secrets in either place.
GATEWAY_DISABLE_TOOLS=false
# Vision routing (v3, verified 2026-09-24): when a request carries images,
# these models are tried FIRST with images attached as serve file parts.
# Default rank: mimo-v2.6-flash-free, muse-spark-1.2, muse-spark-1.3,
# space-bunny (only PASS models; ling/nemotron deny vision, mimo-v2.5 500s).
# Override without code edit: comma-separated refs (bare IDs get opencode/ prefix).
#VISION_RANK_ORDER=opencode/mimo-v2.6-flash-free,opencode/muse-spark-1.3-contributor-free
# Image slam limits per request (extras omitted with a prompt note):
GATEWAY_MAX_IMAGES=5
GATEWAY_MAX_IMAGE_MB=4

# ---- Reliability / resource limits --------------------------------------
# A model that just failed is skipped for this long, so one dead model doesn't
# cost a full timeout on every turn while the free tier is flapping.
GATEWAY_FAIL_COOLDOWN_S=600
# Per-model ceiling is fixed at 150s in code (healthy free models answer in
# ~5-35s, so a longer hang is treated as a failure and falls back).
# Total wall-clock budget for ONE request (all combo models, plus the forced
# -tool retry). Stops a long combo from stacking UPSTREAM_TIMEOUT per model,
# which is what made Claude Desktop give up before the gateway answered.
GATEWAY_TOTAL_BUDGET_S=600
# How long saved inbound images stay in sandbox/img before being pruned
# (keeps long Cowork sessions from filling the disk). 0 disables cleanup.
GATEWAY_IMG_TTL_H=6
# ---- Conversation memory ------------------------------------------------
# The old limits (10 turns / 50k chars / 2k per tool result) threw away
# almost everything: the model lost track of what it had already read and
# re-read the same files. These are still far below every model's real
# context window (smallest free model = 200k tokens), so nothing overflows.
GATEWAY_HISTORY_KEEP_LAST=60
GATEWAY_TRANSCRIPT_CHAR_CAP=400000
# Per-turn render limits. A tool result is what the model "remembers" of a
# file; truncating it at 2000 chars made it re-read the file to get the rest.
GATEWAY_TOOL_RESULT_CHARS=8000
GATEWAY_TOOL_INPUT_CHARS=1500
# Above this prompt size (in chars) we skip the small-context free models and
# prefer the 1M-context ones, so long sessions never overflow or get truncated.
GATEWAY_BIG_PROMPT_CHARS=150000
# NOTE: the gateway also sends the model an explicit "files you already read"
# ledger each turn, so it stops repeating work. Disable with:
# GATEWAY_PROGRESS_LEDGER=false
